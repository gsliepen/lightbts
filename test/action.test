#!/bin/sh

. "${0%/*}/testlib.sh"

# Batch mode
exec 0<&-

# Initialize
$lbts init

# Reply without arguments should fail
fails $lbts reply

# Create a simple bug
echo "This is the first bug." | $lbts create First bug

# Unknown tickets give an error message, not a crash
fails $lbts close 2 2> error
grep -q "No ticket with number 2" error
fails $lbts close abc 2> error
grep -q "Invalid ticket number" error

# Close
fails $lbts close
$lbts close 1
test -z "$($lbts list open)"
test -n "$($lbts list closed)"

# Reopen
fails $lbts reopen
$lbts reopen 1
test -n "$($lbts list open)"
test -z "$($lbts list closed)"

# Retitle
fails $lbts retitle
fails $lbts retitle 1
$lbts retitle 1 Primary ticket
$lbts list | grep -q "Primary ticket"

# Found
fails $lbts found
fails $lbts found 1
$lbts found 1 1.0
$lbts show 1 | grep -q "^Found in: 1.0$"

# Notfound
fails $lbts notfound
fails $lbts notfound 1
$lbts notfound 1 1.0
$lbts show 1 | fails grep -q "^Found in:"

# fixed
fails $lbts fixed
fails $lbts fixed 1
$lbts fixed 1 1.0
$lbts show 1 | grep -q "^Fixed in: 1.0$"

# Notfixed
fails $lbts notfixed
fails $lbts notfixed 1
$lbts notfixed 1 1.0
$lbts show 1 | fails grep -q "^Fixed in:"

# Versions get the status of the ticket
$lbts close -V 2.0 1
$lbts show 1 | grep -q "^Fixed in: 2.0$"
$lbts reopen -V 2.1 1
$lbts show 1 | grep -q "^Found in: 2.1$"

# Severity
fails $lbts severity
fails $lbts severity 1
$lbts severity 1 minor 
$lbts show 1 | grep -q "^Severity: minor$"
fails $lbts severity 1 minor setback

# An invalid severity is reported, but the action is still recorded
$lbts severity 1 extreme 2> error
grep -q 'Invalid severity "extreme"' error
$lbts show 1 | grep -q "^Severity: minor$"

# Link
fails $lbts link
fails $lbts link 1
fails $lbts link 1 blocks
fails $lbts link 1 nonsense 2
echo "This is the second bug." | $lbts create Second bug
$lbts link 1 blocks 2
$lbts show 1 | grep -q "^This bug blocks bug#2: Second bug$"
$lbts show 2 | grep -q "^This bug is blocked by bug#1: Primary ticket$"
fails $lbts link 1 blocks 2 3

# Links to unknown tickets are reported
$lbts link 1 relates 99 2> error
grep -q 'Invalid ticket number "99"' error

# Unlink
fails $lbts unlink
fails $lbts unlink 1
fails $lbts unlink 1 blocks
$lbts unlink 1 blocks 2
$lbts show 1 | fails grep -q "^This bug blocks"
$lbts show 2 | fails grep -q "blocked by"
fails $lbts unlink 1 blocks 2 3

# Tags
fails $lbts tags
fails $lbts tags 1
$lbts tags 1 foo
$lbts show 1 | grep -q "^Tags: foo$"
$lbts tag 1 bar - foo +baz quux
$lbts show 1 | grep -q "^Tags: bar baz quux$"

# Adding an existing tag is not an error
$lbts tags 1 bar
$lbts show 1 | grep -q "^Tags: bar baz quux$"
$lbts tags 1 =only
$lbts show 1 | grep -q "^Tags: only$"

# Owner
fails $lbts owner
fails $lbts owner 1
$lbts owner 1 Firstname Lastname
$lbts show 1 | grep -q "^Owner: Firstname Lastname$"

# Noowner
fails $lbts noowner
$lbts noowner 1
$lbts show 1 | fails grep -q "^Owner:"
fails $lbts noowner Firstname Lastname

# Deadline
fails $lbts deadline
fails $lbts deadline 1
$lbts deadline 1 1970-01-01
$lbts show 1 | grep -q "^Deadline: 1970-01-01$"
$lbts deadline 1 tomorrow 2> error
grep -q "Invalid deadline" error
$lbts show 1 | grep -q "^Deadline: 1970-01-01$"

# Milestone
fails $lbts milestone
fails $lbts milestone 1
$lbts milestone 1 alpha
$lbts show 1 | grep -q "^Milestone: alpha$"

# Progress
fails $lbts progress
fails $lbts progress 1
$lbts progress 1 99%
$lbts show 1 | grep -q "^Progress: 99%$"
fails $lbts progress 1 1% 2% 3%

# Add message
$lbts close 1 -m "That's all folks!"
msgid=$($lbts show 1 | tail -1)
test "$($lbts show $msgid | tail -1)" = "That's all folks!"
