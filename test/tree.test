#!/bin/sh

. "${0%/*}/testlib.sh"

# Batch mode
exec 0<&-

$lbts init
$lbts config field.rank.type number

# A roadmap is a ticket that depends on its items
$lbts create -m "Where we are going.

In two paragraphs." Roadmap 2> /dev/null
$lbts create -F rank=2 --link blocks:1 -m "Rebuild the index." Reindexing 2> /dev/null
$lbts create -F rank=1 --link blocks:1 -m "Configurable fields." Field model 2> /dev/null
$lbts create --link blocks:3 -m "Read the definitions." Parse definitions 2> /dev/null
$lbts create -m "Not part of the roadmap." Unrelated 2> /dev/null
$lbts close 2 2> /dev/null

# --link writes the ID of the other ticket into the first message
$lbts show -v 2 | grep -q "^Blocks: $($lbts get 1 id | cut -c1-16)$"
fails $lbts create --link blocks -m "No ticket." Invalid 2> error
grep -q 'Invalid link "blocks", expected <type>:<ticket>' error
fails $lbts create --link blocks:99 -m "No ticket." Invalid 2> error
grep -q "No ticket with number 99" error
fails $lbts create --link nonsense:1 -m "No ticket." Invalid

# Links can be selected, and follow inverse links: 2 and 3 block 1, so 1 depends on them
test "$(echo $($lbts list all blocks=1 | awk '{print $1}'))" = "2 3"
test "$(echo $($lbts list blocks=1 | awk '{print $1}'))" = "3"
test "$(echo $($lbts list all depends=2 | awk '{print $1}'))" = "1"
test -z "$($lbts list all relates=1)"
fails $lbts list blocks=99

# Sorting
test "$(echo $($lbts list all --sort rank | awk '{print $1}'))" = "3 2 1 4 5"
test "$(echo $($lbts list all --sort -rank | awk '{print $1}'))" = "2 3 1 4 5"
test "$(echo $($lbts list all --sort title | awk '{print $1}'))" = "3 4 2 1 5"
test "$(echo $($lbts list all --sort -number | awk '{print $1}'))" = "5 4 3 2 1"
$lbts config cli.sort rank
test "$(echo $($lbts list all | awk '{print $1}'))" = "3 2 1 4 5"
$lbts config cli.sort ""
fails $lbts list --sort nonexistent

# The tree of a ticket
$lbts tree 1 > tree
cat > expected << EXPECTED
#1 $($lbts get 1 id | cut -c1-7) [open] Roadmap (1/2 done)
    Where we are going.

    In two paragraphs.

    #2 $($lbts get 2 id | cut -c1-7) [closed] Reindexing
    #3 $($lbts get 3 id | cut -c1-7) [open] Field model (0/1 done)
        Configurable fields.

        #4 $($lbts get 4 id | cut -c1-7) [open] Parse definitions
            Read the definitions.

EXPECTED
cmp tree expected

# Without a ticket, all trees are shown, and tickets without links are not
$lbts tree > all
cmp all expected

# Sorting, selectors, depth and verbosity
$lbts tree --sort rank 1 | grep "#" | awk '{print $1}' > order
test "$(echo $(cat order))" = "#1 #3 #4 #2"
$lbts tree 1 open | fails grep -q "Reindexing"
$lbts tree 1 open | grep -q "Parse definitions"
$lbts tree --depth 1 1 | fails grep -q "Parse definitions"
$lbts tree --depth 0 1 | fails grep -q "Field model"
$lbts tree -v 1 | grep -q "^        Rebuild the index.$"
$lbts tree 1 | fails grep -q "Rebuild the index."
test "$($lbts tree 5 | wc -l)" = "3"

# Markdown
$lbts tree --markdown 1 > markdown
grep -q "^# Roadmap$" markdown
grep -q "^\*#1 [0-9a-f]\{7\}, open, 1/2 done\*$" markdown
grep -q "^## Reindexing$" markdown
grep -q "^### Parse definitions$" markdown
grep -q "^In two paragraphs.$" markdown

# JSON
if command -v python3 >/dev/null; then
	$lbts tree --json 1 | python3 -I -c "
import json, sys
tree = json.load(sys.stdin)
assert tree['number'] == 1
assert tree['description'] == 'Where we are going.\n\nIn two paragraphs.\n'
assert [child['number'] for child in tree['children']] == [2, 3]
assert tree['children'][1]['children'][0]['title'] == 'Parse definitions'
"
	test "$($lbts tree --json | python3 -I -c 'import json, sys; print(len(json.load(sys.stdin)))')" = "1"
fi

# Cycles are shown once
$lbts link 1 blocks 4 2> /dev/null
$lbts tree 1 | grep -q "^            #1 [0-9a-f]\{7\} \[open\] Roadmap (1/2 done) (see above)$"
$lbts tree | grep -q "^#1 "

# Other link types can be followed
$lbts link 5 relates 1 2> /dev/null
$lbts tree --link relates | grep -q "^#5 .* Unrelated (0/1 done)$"
$lbts tree --link relates | grep -q "^    #1 .* Roadmap$"
fails $lbts tree --link nonsense
fails $lbts tree 99
