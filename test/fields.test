#!/bin/sh

. "${0%/*}/testlib.sh"

# Batch mode
exec 0<&-

$lbts init

# The default fields are written into the configuration
test "$($lbts config field.status.type)" = "enum"
test "$($lbts config field.status.values)" = "open, closed"
test "$($lbts config field.status.done)" = "closed"
test "$($lbts config field.severity.default)" = "normal"
test "$($lbts config field.tags.aliases)" = "tag"
test "$($lbts config field.progress.max)" = "100"
grep -q "^\[field.status\]$" .lightbts/config

# Sections keep their order
test "$(grep '^\[' .lightbts/config | head -1)" = "[core]"
test "$(grep '^\[field' .lightbts/config | head -1)" = "[field.status]"

# Add a field
$lbts config field.priority.type enum 2> output
grep -q "^Warning: Invalid definition of field \"priority\": an enum field needs values$" output
$lbts config field.priority.values low, normal, high 2> output
test ! -s output
test "$($lbts config field.priority.values)" = "low, normal, high"
$lbts list

# Invalid definitions make the other commands fail, but can still be fixed
$lbts config field.priority.default highest 2> output
grep -q "^Warning: .*the default \"highest\" is not one of low, normal, high$" output
fails $lbts list 2> output
grep -q "error: Invalid definition of field \"priority\"" output
test "$($lbts config field.priority.default)" = "highest"
$lbts config field.priority.default high 2> output
test ! -s output
$lbts list

# The status field is required
sed '/^\[field.status\]$/,/^$/d' .lightbts/config > config
mv config .lightbts/config
fails grep -q "field.status" .lightbts/config
fails $lbts list 2> output
grep -q "error: The status field is not defined$" output

# Without any field sections, as in instances made by older versions, the default fields are used
grep -v "^\[field\." .lightbts/config | grep -v "^	\(type\|values\|default\|done\|close\|reopen\|ordered\|aliases\|min\|max\|unit\) =" > config
mv config .lightbts/config
fails grep -q "field" .lightbts/config
$lbts list
echo "A bug." | $lbts create A bug

# A custom workflow
mkdir custom
cd custom
$lbts init
$lbts config field.status.values new, confirmed, in-progress, fixed, wontfix 2> /dev/null
$lbts config field.status.default new 2> /dev/null
$lbts config field.status.in-progress in-progress 2> /dev/null
$lbts config field.status.done fixed, wontfix 2> /dev/null
$lbts config field.status.close fixed 2> /dev/null
$lbts config field.status.reopen confirmed 2> output
test ! -s output

$lbts create -m "First." First bug 2> output
grep -q "^The field definitions have changed, rebuilding the index...$" output
$lbts create -m "Second." Second bug
$lbts create -m "Third." Third bug
$lbts show 1 | grep -q "^Status: new$"

$lbts close 1
$lbts show 1 | grep -q "^Status: fixed$"
$lbts reopen 1
$lbts show 1 | grep -q "^Status: confirmed$"
$lbts set 2 status in-progress
$lbts set 3 status wontfix

test "$($lbts list | wc -l)" = "2"
test "$($lbts list to-do | awk '{print $1}')" = "1"
test "$($lbts list in-progress | awk '{print $1}')" = "2"
test "$($lbts list done | awk '{print $1}')" = "3"
test "$($lbts list closed | awk '{print $1}')" = "3"
test "$($lbts list wontfix | awk '{print $1}')" = "3"
test "$($lbts list status=in-progress | awk '{print $1}')" = "2"
test "$($lbts list all | wc -l)" = "3"
$lbts list all | grep -q "^     2 [0-9a-f]\{7\} in-progress normal     Second bug$"

# Invalid values are reported, and the action is still recorded
$lbts set 1 status bogus 2> output
grep -q 'Invalid status "bogus", expected one of new, confirmed, in-progress, fixed, wontfix' output
$lbts show 1 | grep -q "^Status: confirmed$"

# Custom fields
$lbts config field.priority.type enum 2> /dev/null
$lbts config field.priority.values low, normal, high
$lbts config field.priority.ordered true
$lbts config field.priority.aliases prio
$lbts config field.component.type set
$lbts config field.component.values core, cli, web
$lbts config field.estimate.type number
$lbts config field.estimate.unit h
$lbts config field.estimate.label Estimated time 2> output
# lbts config doesn't rebuild the index, the next command does
test ! -s output

$lbts fields > fields 2> output
grep -q "rebuilding the index" output
grep -q "^priority$" fields
grep -q "^	values: low, normal, high$" fields
grep -q "^	in-progress: in-progress$" fields
grep -q "^	to-do: new, confirmed$" fields
grep -q "^	label: Estimated time$" fields

$lbts set 1 priority high 2> output
fails grep -q "rebuilding the index" output
$lbts set 2 prio LOW
$lbts show 1 | grep -q "^Priority: high$"
$lbts show 2 | grep -q "^Priority: low$"
$lbts show 3 | fails grep -q "^Priority:"
fails $lbts set 1 priority high low
fails $lbts set 1 nonexistent value
fails $lbts set 1 priority

test "$($lbts list all "priority>=normal" | awk '{print $1}')" = "1"
test "$($lbts list all "priority<high" | awk '{print $1}')" = "2"
test "$($lbts list all priority!=high | wc -l)" = "2"
test "$($lbts list all priority=low priority=high | wc -l)" = "2"
fails $lbts list "priority>=highest" 2> output
grep -q 'Invalid priority "highest"' output
fails $lbts list "component>core"
fails $lbts list "not,a,tag"

$lbts set 1 component web cli
$lbts set 2 component core
$lbts set 2 component bogus 2> output
grep -q 'Invalid component "bogus", expected any of core, cli, web' output
$lbts show 1 | grep -q "^Component: cli web$"
test "$(echo $($lbts list all components))" = "cli core web"
test "$($lbts list all component=web | awk '{print $1}')" = "1"
test "$($lbts list all web | awk '{print $1}')" = "1"
$lbts unset 1 component
$lbts show 1 | fails grep -q "^Component:"

$lbts set 1 estimate 3h
$lbts set 2 estimate 10
$lbts show 1 | grep -q "^Estimated time: 3h$"
test "$($lbts list all "estimate<5" | awk '{print $1}')" = "1"
test "$($lbts list all "estimate>=5h" | awk '{print $1}')" = "2"
$lbts unset 1 estimate
$lbts show 1 | fails grep -q "^Estimated time:"

# Unsetting a field with a default returns it to the default
$lbts set 1 severity grave
$lbts unset 1 severity
$lbts show 1 | grep -q "^Severity: normal$"

# Fields can be set when creating tickets and replying
$lbts create -F priority=high -F component=web -m "Fourth." Fourth bug
$lbts show 4 | grep -q "^Priority: high$"
$lbts show 4 | grep -q "^Component: web$"
$lbts reply -F prio=low -m "Not so important." 4
$lbts show 4 | grep -q "^Priority: low$"
fails $lbts create -F nonexistent=1 -m "Fifth." Fifth bug
fails $lbts create -F priority -m "Fifth." Fifth bug

# Email headers set fields
$lbts import << IMPORT
From: Someone <someone@example.org>
Subject: Imported bug
Message-ID: <imported@test>
X-LightBTS-Priority: high
X-LightBTS-Component: core

An imported bug.
IMPORT
$lbts show imported@test -v | grep -q "^Priority: high$"
$lbts show imported@test -v | grep -q "^Component: core$"

# The columns of lbts list
$lbts config cli.columns priority, status
$lbts list all | grep -q "^     4 [0-9a-f]\{7\} low    new          Fourth bug$"
$lbts config cli.columns bogus
fails $lbts list
$lbts config cli.columns ""

# Without a severity field, its shortcuts don't work
sed '/^\[field.severity\]$/,/^$/d' .lightbts/config > config
mv config .lightbts/config
fails $lbts severity 1 minor 2> output
grep -q 'There is no field named "severity"' output
fails $lbts create -S minor -m "Sixth." Sixth bug
$lbts show 1 | fails grep -q "^Severity:"
$lbts fsck
